{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["env.d.ts", "**/*.ts", "**/*.tsx", ".cloudflare/types"],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    ".next-work-validation",
    "next-env.d.ts"
  ]
}
